# Password for the /admin page
ADMIN_PASSWORD=change-me

# Firebase service account credentials (Firestore).
# Firebase console -> Project settings -> Service accounts -> Generate new private key,
# then copy these three values out of the downloaded JSON.
# If these are unset, the app falls back to a local file store (.data/db.json) —
# fine for local dev, NOT durable on Vercel.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
